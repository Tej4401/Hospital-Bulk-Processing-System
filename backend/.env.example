# --- Downstream Hospital Directory API ---------------------------------
# Base URL of the already-deployed hospital directory API to orchestrate.
EXTERNAL_API_BASE_URL=http://host.docker.internal:8000

# --- Redis (data + state + queue) --------------------------------------
# In docker-compose this is overridden to redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=bulk_hospitals

# --- Upload / processing constraints -----------------------------------
MAX_CSV_HOSPITALS=20
MAX_CONTENT_LENGTH=5242880

# --- Outbound HTTP behaviour -------------------------------------------
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=0.5

# --- Bookkeeping --------------------------------------------------------
BATCH_TTL_SECONDS=604800
JOB_TIMEOUT=1800

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
